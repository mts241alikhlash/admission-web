{
  "name": "admission-web",
  "private": true,
  "version": "0.1.0",
  "description": "241 Admission: admission web app (waves, applications, documents, payments)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,vue,js}\" \"packages/**/*.{ts,vue,js}\" \"smoke/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,vue,js}\" \"packages/**/*.{ts,vue,js}\" \"smoke/**/*.ts\" --fix --max-warnings=0",
    "lint:strict": "eslint -c eslint.typecheck.config.mjs \"src/**/*.{ts,vue}\" \"packages/**/*.{ts,vue}\" \"smoke/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,vue,json,css,scss,html,md}\" \"packages/**/*.{ts,vue,json,css,scss,html,md}\" \"smoke/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,json,css,scss,html,md}\" \"packages/**/*.{ts,vue,json,css,scss,html,md}\" \"smoke/**/*.ts\"",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run format:check && pnpm run lint",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run lint:strict && pnpm run test && pnpm run build && pnpm run routes:check",
    "smoke:gateway": "vitest run --config vitest.smoke.config.ts",
    "routes:check": "node --experimental-strip-types scripts/emit-routing-manifest.mjs --check",
    "routes:emit": "node --experimental-strip-types scripts/emit-routing-manifest.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "@mts241alikhlash/ui": "^0.3.0",
    "@mts241alikhlash/web-shared": "^0.1.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/vue-query": "^5.101.4",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.7.0",
    "@unovis/vue": "^1.7.0",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.41",
    "vue-chrts": "^2.2.1",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "prettier": "3.9.6",
    "shadcn-vue": "^2.8.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.10"
  }
}
